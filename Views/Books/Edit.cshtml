@model BookDB.Models.Book
@{
    ViewData["Title"] = "Sửa sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sửa thông tin sách</h4>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">&#8592; Về trang chủ</a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Image" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label fw-semibold"></label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="Price" class="form-control" type="number" min="0" />
                        <span class="input-group-text">VNĐ</span>
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Hình ảnh bìa sách</label>
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="mb-2">
                            <img id="imgPreview" src="~/images/books/@Model.Image"
                                 onerror="this.src='/images/no-image.svg'"
                                 alt="@Model.Title"
                                 style="max-height:150px;object-fit:contain;border-radius:4px;border:1px solid #ddd;padding:4px;" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-2" id="previewBox" style="display:none;">
                            <img id="imgPreview" src="#" alt="Xem trước"
                                 style="max-height:150px;object-fit:contain;border-radius:4px;border:1px solid #ddd;padding:4px;" />
                        </div>
                    }
                    <input type="file" name="ImageFile" class="form-control" accept="image/*"
                           onchange="previewNewImage(this)" />
                    <small class="text-muted">Chọn ảnh mới nếu muốn thay đổi. Để trống để giữ ảnh cũ.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">Cập nhật</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewNewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('imgPreview');
                    if (preview) {
                        preview.src = e.target.result;
                    }
                    var box = document.getElementById('previewBox');
                    if (box) box.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

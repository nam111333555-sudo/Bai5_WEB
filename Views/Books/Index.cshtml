@model IEnumerable<BookDB.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Quản lý sách</h4>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success btn-sm">+ Thêm sách mới</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">&#8592; Trang chủ</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:90px;">Hình</th>
                    <th>Tên sách</th>
                    <th>Tác giả</th>
                    <th>Giá bán</th>
                    <th>Chủ đề</th>
                    <th style="width:180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(book.Image))
                            {
                                <img src="~/images/books/@book.Image"
                                     onerror="this.src='/images/no-image.svg'"
                                     style="height:65px;width:50px;object-fit:contain;" />
                            }
                            else
                            {
                                <img src="~/images/no-image.svg" style="height:65px;width:50px;" />
                            }
                        </td>
                        <td class="align-middle fw-semibold">@book.Title</td>
                        <td class="align-middle">@book.Author</td>
                        <td class="align-middle text-danger fw-semibold">@book.Price.ToString("N0") đ</td>
                        <td class="align-middle"><span class="badge bg-secondary">@book.Category?.CategoryName</span></td>
                        <td class="align-middle">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có sách nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

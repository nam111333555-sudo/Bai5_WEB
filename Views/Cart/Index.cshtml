@model BookDB.Models.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="row">
    <div class="col-12">
        <h3>Giỏ hàng</h3>

        @if (TempData["CartMessage"] is string cartMessage)
        {
            <div class="alert alert-success">@cartMessage</div>
        }

        @if (!Model.Items.Any())
        {
            <div class="alert alert-info">Giỏ hàng của bạn đang trống.</div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sách</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="~/images/books/@item.Image" alt="@item.Title" width="60" class="img-thumbnail" />
                                        }
                                        <span>@item.Title</span>
                                    </div>
                                </td>
                                <td>@item.Price.ToString("N0") đ</td>
                                <td>@item.Quantity</td>
                                <td>@item.Total.ToString("N0") đ</td>
                                <td>
                                    <a asp-action="Remove" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold">@Model.Total.ToString("N0") đ</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
                <a asp-action="Clear" class="btn btn-secondary">Xóa giỏ hàng</a>
            </div>
        }
    </div>
</div>
